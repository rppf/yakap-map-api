{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yakap-map-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "vars": {
    "CORS_ORIGIN": "https://yakap-map-web.vercel.app"
  },
  "observability": {
    "enabled": true
  }
}
