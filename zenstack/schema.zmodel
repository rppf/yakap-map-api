datasource db {
    provider = 'postgresql'
    url      = env('DATABASE_URL')
}

plugin policy {
    provider = "@zenstackhq/plugin-policy"
}

// Aligned with the existing `health_facilities` table in Neon (see prisma db pull).
// The PostGIS `coordinates` geography column is not queryable via Prisma — the
// plain longitude/latitude columns are retained in the DB so no data is lost, but
// they no longer drive list queries (the API is tag-based, not map-based).
model HealthFacility {
    id                    BigInt   @id @default(autoincrement())
    name                  String   @map('health_facility_name') @db.VarChar(255)
    region                String?  @db.VarChar(100)
    area                  String?  @db.VarChar(100)
    municipality          String?  @db.VarChar(150)
    street                String?
    email                 String?  @db.VarChar(255)
    withYakapPrescription Boolean? @default(false) @map('with_yakap_prescription')
    expirationDate        DateTime? @db.Date @map('expiration_date')
    coordinates           Unsupported("geography")?
    createdAt             DateTime? @default(now()) @db.Timestamptz(6) @map('created_at')
    updatedAt             DateTime? @default(now()) @db.Timestamptz(6) @map('updated_at')
    longitude             Float?   @db.Real
    latitude              Float?   @db.Real
    contactNumbers        String?  @map('contact_numbers')

    facilityTags FacilityTag[]

    // Public read-only API: allow reads to everyone, deny all writes.
    @@allow('read', true)

    @@map('health_facilities')
}

model Tag {
    id          BigInt  @id @default(autoincrement())
    name        String  @db.VarChar(100)
    slug        String  @unique @db.VarChar(100)
    description String?

    facilityTags FacilityTag[]

    // Public read-only API: allow reads to everyone, deny all writes.
    @@allow('read', true)

    @@map('tags')
}

model FacilityTag {
    facilityId BigInt @map('facility_id')
    tagId      BigInt @map('tag_id')

    facility HealthFacility @relation(fields: [facilityId], references: [id])
    tag      Tag            @relation(fields: [tagId], references: [id])

    @@id([facilityId, tagId])

    // Public read-only API: allow reads to everyone, deny all writes.
    @@allow('read', true)

    @@map('facility_tags')
}
